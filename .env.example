# BrandVerita Generation Test — example environment variables.
# Copy to .env for local dev. NEVER commit real values.
# For Netlify, set these in Site settings → Environment variables.

# Generation API (separate Modal FastAPI service). Required to enable generation.
VITE_GENERATION_API_URL="https://your-modal-app.modal.run"
VITE_GENERATION_ENABLED="true"

# Supabase (comfy-ui project) — client-safe publishable/anon key only.
# These ship to the browser by design; RLS is the real access control.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_publishable_key_here"
VITE_SUPABASE_PROJECT_ID="your-project-ref"

# --- NEVER commit these (server-only, listed here only as a warning) ---
# SUPABASE_SERVICE_ROLE_KEY   (FastAPI / server use only — not in this repo)
# MODAL_TOKEN_ID / MODAL_TOKEN_SECRET   (FastAPI use only — not in this repo)
# HUGGINGFACE_TOKEN   (Modal worker use only — not in this repo)
# STUDIO_HANDOFF_SECRET   (not used by this project)
